 * Конфигурация приложения.
 * Заполните данные вашей базы данных (создаются в панели хостинга Timeweb).
 */

// --- Параметры подключения к базе данных ---
// Впишите сюда реальные данные базы, которую вы создали в панели хостинга.
define('DB_HOST', 'localhost');            // обычно localhost
define('DB_NAME', 'c73065_meh');     // имя базы данных из панели Timeweb
define('DB_USER', 'c73065_meh');  // пользователь БД из панели Timeweb
define('DB_PASS', 'ПАРОЛЬ_БД_СЮДА');        // пароль БД из панели Timeweb
define('DB_CHARSET', 'utf8mb4');

// --- Название организации/системы (отображается в заголовке вкладки браузера) ---
define('APP_NAME', 'Техноресурс — Служба механиков');

// --- Логотип в боковом меню: две части, вторая подсвечивается цветом ---
// Чтобы изменить название компании, поправьте эти две строки.
define('BRAND_PREFIX', 'Техно');
define('BRAND_SUFFIX', 'Ресурс');

// --- Папка для загрузки фотографий (относительно корня сайта) ---
define('UPLOAD_DIR', __DIR__ . '/uploads/tasks');
define('UPLOAD_URL', 'uploads/tasks');

// --- Максимальный размер загружаемого фото, байт (10 МБ) ---
define('MAX_UPLOAD_SIZE', 10 * 1024 * 1024);

// --- Часовой пояс ---
date_default_timezone_set('Europe/Moscow');

// --- Показ ошибок: включите true только на время первичной настройки,
//     затем обязательно верните false (иначе ошибки видны всем посетителям сайта) ---
define('APP_DEBUG', false);

if (APP_DEBUG) {
    error_reporting(E_ALL);
    ini_set('display_errors', '1');
} else {
    error_reporting(0);
    ini_set('display_errors', '0');
}
